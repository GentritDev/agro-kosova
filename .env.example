# Runtime: Neon pooled connection string. Used by the Prisma Neon adapter on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Migrations: Neon direct/non-pooled connection string. Used only by Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Long random value (at least 32 characters) used to sign rate-limit and session-related data.
APP_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Vercel Blob read/write token. Needed for farmer product photo uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
